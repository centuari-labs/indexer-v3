{
    "name": "@centuari/indexer-v3",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Centuari Phase 1 custom blockchain indexer (hub + 4 spokes)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./shared/apply-on-chain-effect": {
            "types": "./dist/shared/apply-on-chain-effect.d.ts",
            "default": "./dist/shared/apply-on-chain-effect.js"
        }
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "migrate": "tsx src/db/migrate.ts",
        "copy-abi": "tsx scripts/copy-abi.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "biome check --write src",
        "format": "biome format --write src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.1",
        "fastify": "^5.1.0",
        "pg": "^8.13.1",
        "pino": "^9.5.0",
        "prom-client": "^15.1.3",
        "viem": "^2.21.48",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.4",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "pino-pretty": "^13.0.0",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=22"
    }
}
