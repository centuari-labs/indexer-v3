{
    "name": "@centuari/indexer-v3",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Centuari Phase 1 custom blockchain indexer (hub + 4 spokes)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "test": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "lint": "biome check --write src",
        "format": "biome format --write src",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@centuari-labs/on-chain-effects": "^0.4.0",
        "@fastify/cors": "^10.0.1",
        "dotenv": "^16.4.5",
        "fastify": "^5.1.0",
        "pg": "^8.13.1",
        "pino": "^9.5.0",
        "prom-client": "^15.1.3",
        "viem": "^2.21.48",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.4",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "pg-mem": "^3.0.4",
        "pino-pretty": "^13.0.0",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=22"
    }
}
