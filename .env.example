SPOKE_BASE_START_BLOCK=0
SPOKE_BASE_FINALITY_DEPTH=32
SPOKE_BASE_DEPOSIT_GATEWAY_ADDRESS=0x0000000000000000000000000000000000000000
SPOKE_BASE_VAULT_STABLE_ADDRESS=0x0000000000000000000000000000000000000000

