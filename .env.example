# ---- Core ----
DATABASE_URL=postgres://centuari:password@localhost:5432/centuari
PORT=42069
LOG_LEVEL=info
NODE_ENV=development

# Hub-only launch gate. When true, only the Arbitrum hub ChainWatcher runs; the
# SPOKE_* sections below are ignored and may be left unset (no spoke RPC
# connections, no spoke watcher error noise). Leave false (default) to index the
# hub + all 4 spokes. SET TO true FOR THE HUB-ONLY LAUNCH (and mainnet).
HUB_ONLY=false

# ---- Watcher tuning (throughput / safety) ----
# Defaults match the historical hard-coded constants. The indexer batches one
# ranged getLogs per tick and only fetches headers for zero-log blocks, so the
# defaults keep pace with the Arbitrum hub. On a faster chain or a slower RPC,
# raise INDEXER_LOGS_RANGE_CHUNK / INDEXER_HEADER_CONCURRENCY (or provision a
# paid RPC) rather than touching code.
INDEXER_POLL_INTERVAL_MS=4000
# Max blocks processed per tick (bounds per-tick DB work + reorg-check cadence).
INDEXER_MAX_BLOCKS_PER_TICK=500
# Max block span per getLogs call. RPCs cap this; the watcher auto-halves the
# span and retries on a range-limit error. Keep >= INDEXER_MAX_BLOCKS_PER_TICK
# so a normal tick is a single getLogs call.
INDEXER_LOGS_RANGE_CHUNK=2000
# Max concurrent getBlock header fetches for empty (zero-log) blocks.
INDEXER_HEADER_CONCURRENCY=10
# Retries for a transient empty-block header miss before deferring to next tick.
INDEXER_HEADER_RETRIES=2

# ---- Hub: Arbitrum Sepolia ----
HUB_CHAIN_ID=421614
HUB_RPC_URL_WS=wss://arb-sepolia.example/ws
HUB_RPC_URL_HTTP=https://arb-sepolia.example
# Block to start indexing from. NOT auto-synced by sync-to-services.sh (the
# deployment summary carries no deploy-block), so AFTER EVERY REDEPLOY set this
# to the deployment block — otherwise the indexer rescans from genesis. Leaving
# it 0 on a brownfield chain replays millions of blocks. See the redeploy
# runbook in smart-contract-revamp/CLAUDE.md.
HUB_START_BLOCK=0
HUB_FINALITY_DEPTH=12

# ---- Hub contracts ----
BALANCE_LEDGER_ADDRESS=0x0000000000000000000000000000000000000000
CENTUARI_ADDRESS=0x0000000000000000000000000000000000000000
HUB_DEPOSITOR_ADDRESS=0x0000000000000000000000000000000000000000
HUB_INTENT_SETTLER_ADDRESS=0x0000000000000000000000000000000000000000
WITHDRAWAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_LEDGER_ADDRESS=0x0000000000000000000000000000000000000000
COLLATERAL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
LIQUIDATION_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Spoke: Base Sepolia ----
SPOKE_BASE_CHAIN_ID=84532
SPOKE_BASE_RPC_URL_WS=wss://base-sepolia.example/ws
