{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "rootDir": ".",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "types": ["jest", "node"]
    },
    "include": ["src/**/*", "test/**/*"]
}
